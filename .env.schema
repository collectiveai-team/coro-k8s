# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# The variables of coro_batch.settings.BatchSettings. All optional; the defaults are the class's.
#
# @defaultRequired=false @defaultSensitive=false
# ----------

# Base URL of the coro Service, inside the cluster.
CORO_BATCH_CORO_URL=

# The `model` form field sent to coro; coro serves its configured model.
CORO_BATCH_CORO_MODEL=

# Seconds to wait for one transcription response.
CORO_BATCH_CORO_TIMEOUT_SECONDS=

# Attempts of a step before the job fails: transcription and callback.
CORO_BATCH_MAX_ATTEMPTS=

# Longest wait between two attempts, Retry-After included.
CORO_BATCH_MAX_RETRY_WAIT_SECONDS=

# Key that signs callbacks with HMAC-SHA256. Unset sends them unsigned.
# @sensitive
CORO_BATCH_CALLBACK_SECRET=

# Name of a Prefect Secret block holding the callback key, when CORO_BATCH_CALLBACK_SECRET is unset.
CORO_BATCH_CALLBACK_SECRET_BLOCK=

# Prefect global concurrency limit held around each transcription. Empty disables it.
CORO_BATCH_CONCURRENCY_LIMIT=

# Directory for downloaded audio. Unset uses the system temp dir.
CORO_BATCH_WORK_DIR=

# Log level.
CORO_BATCH_LOG_LEVEL=

# `prod` writes JSON logs; anything else writes console lines.
CORO_BATCH_ENV=
